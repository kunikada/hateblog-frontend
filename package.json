{
  "name": "hateblog-frontend",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "deps:interactive": "pnpm up -i --latest",
    "openapi:lint": "redocly lint openapi.yaml",
    "openapi:generate": "openapi-ts",
    "prerender:top": "pnpm exec tsx scripts/prerender-top.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-gtm-module": "^2.0.11",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@redocly/cli": "^2.77.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-vite-plugin": "^1.167.49",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-gtm-module": "^2.0.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
